# Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# Supabase Configuration
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ZeptoMail SMTP Configuration (for email notifications)
# Get these from your ZeptoMail dashboard: https://www.zeptomail.com/
ZEPTOMAIL_USER=emailapikey
ZEPTOMAIL_PASS=your-zeptomail-smtp-password
ZEPTOMAIL_FROM_EMAIL=noreply@yourdomain.com

# ZeptoMail Template IDs
ZEPTOMAIL_TEMPLATE_REQUEST_EN=2d6f.44fc2c40e7cab6be.k1.551d9750-3d1b-11f1-bde5-765e7256bde4.19dad7f6d45
ZEPTOMAIL_TEMPLATE_REQUEST_ES=2d6f.44fc2c40e7cab6be.k1.36271ed0-3d1f-11f1-bde5-765e7256bde4.19dad98d93d
ZEPTOMAIL_TEMPLATE_APPLICATION_EN=2d6f.44fc2c40e7cab6be.k1.7d6bb540-3d1e-11f1-bde5-765e7256bde4.19dad941e94
ZEPTOMAIL_TEMPLATE_APPLICATION_ES=2d6f.44fc2c40e7cab6be.k1.3951f5c0-3d1b-11f1-bde5-765e7256bde4.19dad7eb71c

# Admin Email (where notifications will be sent)
ADMIN_EMAIL=contact@lumitya.com

# Other configuration
NODE_ENV=development